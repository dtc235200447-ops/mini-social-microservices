# Copy this file to .env and replace every placeholder before running Docker Compose.
# Never commit .env files or Google Cloud service account key files.

JWT_SECRET=change-me-use-openssl-rand-hex-32

DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=postgres
DB_PASS=change-me
DB_NAME=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

RABBITMQ_DEFAULT_USER=omnisocial
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

GCS_BUCKET_NAME=your-gcs-bucket
GCS_KEY_FILE=./gcs-key.json

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

JSON_BODY_LIMIT=1mb
MAX_UPLOAD_BYTES=5242880
